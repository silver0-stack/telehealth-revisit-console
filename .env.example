# Copy to .env.local and fill in. Never commit .env.local.

# Which symptom matcher to use: "rules" (default, no network) or "jev" (needs the key below).
MATCHER=rules

# Vercel AI Gateway key. Only needed when MATCHER=jev. Jev is not in the free tier:
# the team needs paid AI Gateway credits, or calls fail with 403.
AI_GATEWAY_API_KEY=

# Where review decisions, AI suggestions, the audit log and saved rule versions are kept:
# "memory" (default, lost on restart, no setup) or "postgres" (needs DATABASE_URL; used by the deployed demo).
STORE=memory

# Neon Postgres connection string. Only needed when STORE=postgres. On Vercel the Neon integration
# sets it for you. Tables are created on first use.
DATABASE_URL=
