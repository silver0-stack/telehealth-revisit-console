# Copy to .env.local and fill in. Never commit .env.local.

# Which symptom matcher to use: "rules" (default, no network) or "jev" (needs the key below).
MATCHER=rules

# Vercel AI Gateway key. Only needed when MATCHER=jev. Jev is not in the free tier:
# the team needs paid AI Gateway credits, or calls fail with 403.
AI_GATEWAY_API_KEY=
